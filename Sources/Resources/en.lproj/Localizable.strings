/* How to play */
"howto.title" = "How to play";
"howto.goal" = "Goal";
"howto.goal.body" = "Shards fall from the rim towards the core. Close a whole ring, or line up five cells of one colour along a ring, to clear them. Everything outside slides inwards. The game ends when a shard can no longer enter the well.";
"howto.controls" = "Controls";
"howto.controls.move" = "Drag left or right to turn the well under the shard";
"howto.controls.rotate" = "Tap either side of the board to turn the shard";
"howto.controls.soft" = "Drag down to fall faster";
"howto.controls.hard" = "Swipe down to drop straight to the core";
"howto.controls.pulse" = "Swipe up, or tap the core, to fire a charged pulse";
"howto.scoring" = "Scoring";
"howto.scoring.body" = "Every cleared cell scores, a closed ring adds a bonus and a fused arc adds another. When cells slide inwards and line up into a new clear, that is a chain: each link multiplies the whole step. Cleared cells also charge the core.";
"howto.tips" = "Tips";
"howto.tips.body" = "Build arcs of one colour while you wait for a ring to close. Leave colour pairs outside an almost-finished arc to set up chains. Keep the pulse for emergencies near the rim. The faded outline shows where a drop will land. Guided practice in the menu walks through each idea.";


