/* How to play */
"howto.title" = "How to play";
"howto.goal" = "Goal";
"howto.goal.body" = "Move and rotate seven four-block pieces. Fill horizontal rows of 10 blocks to clear them. Rows above move down. The game ends when the stack reaches the top. Colours do not affect the rules.";
"howto.controls" = "Controls";
"howto.controls.move" = "Drag sideways or hold the arrow buttons to move the piece";
"howto.controls.rotate" = "Tap the left or right side of the board to rotate in that direction";
"howto.controls.soft" = "Drag down to fall faster";
"howto.controls.hard" = "Swipe down quickly or use the hard drop button";
"howto.controls.pulse" = "Swipe up, or tap the core, to fire a charged pulse";
"howto.scoring" = "Scoring";
"howto.scoring.body" = "Clear one, two, three or four lines at once for 40, 100, 300 or 1200 points multiplied by the level. Every 10 lines increases the level in Classic. Soft drop earns 1 point per cell and hard drop earns 2.";
"howto.tips" = "Tips";
"howto.tips.body" = "Keep the stack low and avoid holes. Leave a column for the long piece to clear four lines at once. One upcoming piece is shown. Enable the landing guide in Settings if needed.";


